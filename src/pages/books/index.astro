---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('ja');
---

<BaseLayout title={`${t('books.title')} - 群青研究所`}>
  <section class="container-wide pt-24 md:pt-32 pb-20">
    <div class="mb-16">
      <p class="text-sm uppercase tracking-widest text-[color:var(--color-accent)] mb-4 flex items-center gap-2">
        <span class="glow-dot"></span>
        {t('books.title')}
      </p>
      <h1 class="text-4xl md:text-5xl font-semibold tracking-tight mb-6">
        {t('books.heading')}
      </h1>
      <p class="text-lg text-[color:var(--color-ink-muted)] max-w-2xl leading-relaxed">
        {t('books.description')}
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      <a href="https://gihyo.jp/book/2025/978-4-297-15327-4" target="_blank" rel="noopener noreferrer" class="card group block">
        <div class="flex items-center justify-between gap-4 mb-4">
          <span class="tag">{t('books.book.label')}</span>
          <span class="text-xs text-[color:var(--color-ink-subtle)]">2025.11.25</span>
        </div>
        <h2 class="text-2xl font-semibold tracking-tight group-hover:text-[color:var(--color-accent)] transition-colors mb-2">MCPサーバー開発大全</h2>
        <p class="text-xs uppercase tracking-wider text-[color:var(--color-accent)] mb-4">岡翔子 著 · 高山洪銘、餌打優太 監修 · 技術評論社</p>
        <p class="text-sm text-[color:var(--color-ink-muted)] leading-relaxed">{t('books.book.description')}</p>
      </a>

      <a href="https://arxiv.org/abs/2506.07896" target="_blank" rel="noopener noreferrer" class="card group block">
        <div class="flex items-center justify-between gap-4 mb-4">
          <span class="tag">{t('books.paper.label')}</span>
          <span class="text-xs text-[color:var(--color-ink-subtle)]">arXiv:2506.07896</span>
        </div>
        <h2 class="text-xl font-semibold tracking-tight group-hover:text-[color:var(--color-accent)] transition-colors mb-2 leading-snug">Evaluating Large Language Models on the Frame and Symbol Grounding Problems: A Zero-shot Benchmark</h2>
        <p class="text-xs uppercase tracking-wider text-[color:var(--color-accent)] mb-4">Shoko Oka · 2025</p>
        <p class="text-sm text-[color:var(--color-ink-muted)] leading-relaxed">{t('books.paper.description')}</p>
      </a>
    </div>
  </section>
</BaseLayout>
