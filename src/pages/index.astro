---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n/utils';

const t = useTranslations('ja');
---

<BaseLayout title="群青研究所 — デジタルの力で医療を前進させる">
  {/* ヒーロー */}
  <section class="relative grid-bg">
    <div class="container-wide pt-28 md:pt-40 pb-20 relative z-10">
      <h1 class="text-5xl md:text-7xl font-semibold tracking-tight leading-tight mb-8 max-w-3xl text-[color:var(--color-accent)]">
        群青研究所
      </h1>
      <p class="text-lg text-[color:var(--color-ink-muted)] max-w-2xl leading-relaxed mb-10">
        {t('home.intro')}
      </p>
      <div class="flex flex-wrap gap-4">
        <a href="/about/" class="btn-primary">{t('home.cta.about')}</a>
        <a href="/projects/" class="btn-outline">{t('home.cta.projects')}</a>
      </div>
    </div>
    {/* ヒーローのグロー装飾 */}
    <div class="absolute top-20 right-10 w-64 h-64 rounded-full bg-[color:var(--neon-cyan)] opacity-[0.03] blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-10 left-20 w-48 h-48 rounded-full bg-[color:var(--neon-magenta)] opacity-[0.03] blur-3xl pointer-events-none"></div>
  </section>

  <hr class="divider" />

  {/* プロジェクト */}
  <section class="container-wide py-20">
    <h2 class="text-sm uppercase tracking-widest text-[color:var(--color-ink-subtle)] mb-10 flex items-center gap-3">
      <span class="w-8 h-px bg-[color:var(--color-accent)]"></span>
      {t('home.section.projects')}
    </h2>

    <div class="grid md:grid-cols-2 gap-6">
      <div class="card group block">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-xl font-semibold tracking-tight">
            Promethica
          </h3>
          <span class="tag">{t('projects.status.mvp')}</span>
        </div>
        <p class="text-xs uppercase tracking-wider text-[color:var(--color-accent)] mb-3">
          {t('projects.promethica.tagline')}
        </p>
        <p class="text-sm text-[color:var(--color-ink-muted)] leading-relaxed">
          {t('projects.promethica.description')}
        </p>
      </div>

      <div class="card group block">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-xl font-semibold tracking-tight">
            Ulucus
          </h3>
          <span class="tag">{t('projects.status.experiment')}</span>
        </div>
        <p class="text-xs uppercase tracking-wider text-[color:var(--color-accent)] mb-3">
          {t('projects.ulucus.tagline')}
        </p>
        <p class="text-sm text-[color:var(--color-ink-muted)] leading-relaxed">
          {t('projects.ulucus.description')}
        </p>
      </div>

      <div class="card group block">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-xl font-semibold tracking-tight">
            Pyrer
          </h3>
          <span class="tag">{t('projects.status.patent')}</span>
        </div>
        <p class="text-xs uppercase tracking-wider text-[color:var(--color-accent)] mb-3">
          {t('projects.pyrer.tagline')}
        </p>
        <p class="text-sm text-[color:var(--color-ink-muted)] leading-relaxed">
          {t('projects.pyrer.description')}
        </p>
      </div>

      <a href="/projects/selinsa/" class="card group block">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-xl font-semibold tracking-tight group-hover:text-[color:var(--color-accent)] transition-colors">
            selinsa
          </h3>
          <span class="tag">{t('projects.status.store')}</span>
        </div>
        <p class="text-xs uppercase tracking-wider text-[color:var(--color-accent)] mb-3">
          {t('projects.selinsa.tagline')}
        </p>
        <p class="text-sm text-[color:var(--color-ink-muted)] leading-relaxed">
          {t('projects.selinsa.description')}
        </p>
      </a>
    </div>
  </section>
</BaseLayout>
