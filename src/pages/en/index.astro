---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('en');
---

<BaseLayout title="Cyanos Lab — AI & Life Science">
  {/* Hero */}
  <section class="relative grid-bg">
    <div class="container-wide pt-28 md:pt-40 pb-20 relative z-10">
      <h1 class="text-5xl md:text-7xl font-semibold tracking-tight leading-tight mb-8 max-w-3xl text-[color:var(--color-accent)]">
        Cyanos Lab
      </h1>
      <p class="text-lg text-[color:var(--color-ink-muted)] max-w-2xl leading-relaxed mb-10">
        {t('home.intro')}
      </p>
      <div class="flex flex-wrap gap-4">
        <a href="/en/about/" class="btn-primary">{t('home.cta.about')}</a>
        <a href="/en/projects/" class="btn-outline">{t('home.cta.projects')}</a>
      </div>
    </div>
    <div class="absolute top-20 right-10 w-64 h-64 rounded-full bg-[color:var(--neon-cyan)] opacity-[0.03] blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-10 left-20 w-48 h-48 rounded-full bg-[color:var(--neon-magenta)] opacity-[0.03] blur-3xl pointer-events-none"></div>
  </section>

  <hr class="divider" />

  {/* Projects */}
  <section class="container-wide py-20">
    <h2 class="text-sm uppercase tracking-widest text-[color:var(--color-ink-subtle)] mb-10 flex items-center gap-3">
      <span class="w-8 h-px bg-[color:var(--color-accent)]"></span>
      {t('home.section.projects')}
    </h2>

    <div class="grid md:grid-cols-2 gap-6">
      <a href="/en/projects/promethica/" class="card group block">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-xl font-semibold tracking-tight group-hover:text-[color:var(--color-accent)] transition-colors">
            Promethica
          </h3>
          <span class="tag">{t('projects.status.mvp')}</span>
        </div>
        <p class="text-xs uppercase tracking-wider text-[color:var(--color-accent)] mb-3">
          {t('projects.promethica.tagline')}
        </p>
        <p class="text-sm text-[color:var(--color-ink-muted)] leading-relaxed">
          {t('projects.promethica.description')}
        </p>
      </a>

      <a href="/en/projects/selinsa/" class="card group block">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-xl font-semibold tracking-tight group-hover:text-[color:var(--color-accent)] transition-colors">
            selinsa
          </h3>
          <span class="tag">{t('projects.status.store')}</span>
        </div>
        <p class="text-xs uppercase tracking-wider text-[color:var(--color-accent)] mb-3">
          {t('projects.selinsa.tagline')}
        </p>
        <p class="text-sm text-[color:var(--color-ink-muted)] leading-relaxed">
          {t('projects.selinsa.description')}
        </p>
      </a>

      <a href="/en/projects/sonde/" class="card group block">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-xl font-semibold tracking-tight group-hover:text-[color:var(--color-accent)] transition-colors">
            Sonde
          </h3>
          <span class="tag">{t('projects.status.building')}</span>
        </div>
        <p class="text-xs uppercase tracking-wider text-[color:var(--color-accent)] mb-3">
          {t('projects.sonde.tagline')}
        </p>
        <p class="text-sm text-[color:var(--color-ink-muted)] leading-relaxed">
          {t('projects.sonde.description')}
        </p>
      </a>
    </div>
  </section>

  <hr class="divider" />

  <section class="container-wide py-20">
    <div class="flex items-end justify-between gap-6 mb-10">
      <h2 class="text-sm uppercase tracking-widest text-[color:var(--color-ink-subtle)] flex items-center gap-3">
        <span class="w-8 h-px bg-[color:var(--color-accent)]"></span>
        {t('home.section.books')}
      </h2>
      <a href="/en/books/" class="text-sm text-[color:var(--color-ink-muted)] hover:text-[color:var(--color-accent)] transition-colors">
        {t('home.cta.books')} →
      </a>
    </div>
    <div class="grid md:grid-cols-2 gap-6">
      <a href="https://gihyo.jp/book/2025/978-4-297-15327-4" target="_blank" rel="noopener noreferrer" class="card group block">
        <span class="tag mb-4">{t('books.book.label')}</span>
        <h3 class="text-xl font-semibold tracking-tight group-hover:text-[color:var(--color-accent)] transition-colors mb-3">
          The Complete Guide to MCP Server Development
        </h3>
        <p class="text-sm text-[color:var(--color-ink-muted)] leading-relaxed">{t('books.book.description')}</p>
      </a>
      <a href="https://arxiv.org/abs/2506.07896" target="_blank" rel="noopener noreferrer" class="card group block">
        <span class="tag mb-4">{t('books.paper.label')}</span>
        <h3 class="text-lg font-semibold tracking-tight group-hover:text-[color:var(--color-accent)] transition-colors mb-3 leading-snug">
          Evaluating Large Language Models on the Frame and Symbol Grounding Problems
        </h3>
        <p class="text-sm text-[color:var(--color-ink-muted)] leading-relaxed">{t('books.paper.description')}</p>
      </a>
    </div>
  </section>
</BaseLayout>
