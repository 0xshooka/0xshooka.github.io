---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { useTranslations } from '../../../i18n/utils';

const t = useTranslations('en');
---

<BaseLayout title={`${t('projects.title')} - Shoko Oka`}>
  <section class="container-wide pt-24 md:pt-32 pb-20">
    <div class="mb-16">
      <p class="text-sm uppercase tracking-widest text-[color:var(--color-accent)] mb-4 flex items-center gap-2">
        <span class="glow-dot"></span>
        {t('projects.title')}
      </p>
      <h1 class="text-4xl md:text-5xl font-semibold tracking-tight mb-6">
        {t('projects.heading')}
      </h1>
      <p class="text-lg text-[color:var(--color-ink-muted)] max-w-2xl leading-relaxed">
        {t('projects.description')}
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      <a href="/en/projects/selinsa/" class="card group block">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-2xl font-semibold tracking-tight group-hover:text-[color:var(--color-accent)] transition-colors">
            selinsa
          </h2>
          <span class="tag">{t('projects.status.active')}</span>
        </div>
        <p class="text-xs uppercase tracking-wider text-[color:var(--color-accent)] mb-3">
          {t('projects.selinsa.tagline')}
        </p>
        <p class="text-sm text-[color:var(--color-ink-muted)] leading-relaxed mb-4">
          {t('projects.selinsa.description')}
        </p>
        <div class="flex gap-2">
          <span class="tag text-[10px]">iOS</span>
          <span class="tag text-[10px]">Android</span>
          <span class="tag text-[10px]">PDF</span>
        </div>
      </a>

      <a href="/en/projects/sonde/" class="card group block">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-2xl font-semibold tracking-tight group-hover:text-[color:var(--color-accent)] transition-colors">
            Sonde
          </h2>
          <span class="tag">{t('projects.status.active')}</span>
        </div>
        <p class="text-xs uppercase tracking-wider text-[color:var(--color-accent)] mb-3">
          {t('projects.sonde.tagline')}
        </p>
        <p class="text-sm text-[color:var(--color-ink-muted)] leading-relaxed mb-4">
          {t('projects.sonde.description')}
        </p>
        <div class="flex gap-2">
          <span class="tag text-[10px]">AI</span>
          <span class="tag text-[10px]">Media</span>
          <span class="tag text-[10px]">Bilingual</span>
        </div>
      </a>
    </div>
  </section>
</BaseLayout>
